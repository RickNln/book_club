# Строка подключения Neon (Vercel → Storage → Neon подставит сама)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Любая длинная случайная строка: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string
# Часовой пояс, по которому считается "сегодня"
APP_TZ=Europe/Moscow
# Первый админ (используется только скриптом db:seed)
ADMIN_LOGIN=rick
ADMIN_PASSWORD=change-me
ADMIN_NAME=Rick
